          "type": "collapsible_row",
          "settings": {
            "heading": "How long does it take to dry clothes?",
            "row_content": "<p>It depends on how thick they are. Everyday T-shirts usually dry in one cycle; thicker items such as blankets take two to three cycles.</p>",
            "icon": "question_mark"
          }
        },
        "faq_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do you install on a false ceiling?",
            "row_content": "<p>The installer drills through the false ceiling and fixes the rack to the concrete ceiling above. We advise a site survey first, to check how deep the false ceiling is and whether there is piping or wiring.</p>",
            "icon": "question_mark"
          }
        },
        "faq_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the load capacity?",
            "row_content": "<p>It depends on the model. Current models carry 45 kg or 55 kg.</p>",
            "icon": "question_mark"
          }
        },
        "faq_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does the warranty work?",
            "row_content": "<p>Five years on the core DC drive motor, two years on all hardware structural components, and one year on the wireless remote and smart control panels.</p>",
            "icon": "question_mark"
          }
        }
