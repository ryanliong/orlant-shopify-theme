      "blocks": {
        "row_0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is installation included?",
            "row_content": "<p>Yes. Every rack is installed by an Orlant technician at no extra cost.</p>",
            "icon": "question_mark"
          }
        },
        "row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will it work with a false ceiling?",
            "row_content": "<p>Yes. A false ceiling needs a mounting plate anchored through to the structural slab above. Our installer checks this on site before drilling.</p>",
            "icon": "question_mark"
          }
        },
        "row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need HDB permission?",
            "row_content": "<p>No permit is required for a ceiling-mounted drying rack in an HDB flat.</p>",
            "icon": "question_mark"
          }
        },
        "row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What power supply is needed?",
            "row_content": "<p>A standard 13A socket within two metres of the unit.</p>",
            "icon": "question_mark"
          }
        }
      },
      "block_order": [
        "row_0",
        "row_1",
        "row_2",
        "row_3"
      ]
