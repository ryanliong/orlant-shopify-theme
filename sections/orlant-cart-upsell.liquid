{%- comment -%}
  "You may also need" — accessories and add-ons on the cart page.

  Products come from a collection chosen in section settings rather than from
  Shopify's recommendations API: accessories for a ceiling-installed appliance
  (extra poles, remotes, mounting plates) are a fixed, small set the client
  curates, not something to infer from browsing behaviour.

  Hides itself when the cart is empty or the collection is unset, so the empty
  cart stays a clean dead end with one way out.
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show

  assign has_items = false
  if cart.item_count > 0 and collection != blank and collection.products.size > 0
    assign has_items = true
  endif
-%}

{%- if has_items -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="orlant-upsell page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="orlant-upsell__heading h3">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul
        class="orlant-upsell__grid grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down list-unstyled"
        role="list"
      >
        {%- for product in collection.products limit: limit -%}
          {%- comment -%}
            Products already in the cart are skipped — offering someone the
            thing they have just added reads as broken.
          {%- endcomment -%}
          {%- assign in_cart = false -%}
          {%- for line in cart.items -%}
            {%- if line.product_id == product.id -%}
              {%- assign in_cart = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- unless in_cart -%}
            <li class="grid__item">
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_secondary_image: false,
                show_vendor: false,
                show_rating: false,
                section_id: section.id
              -%}
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Orlant: cart upsell",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown on the cart page under the line items. Hidden when the cart is empty or no collection is chosen. Products already in the cart are skipped."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "You may also need",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Accessories and add-ons, e.g. spare poles, remotes, mounting plates."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Maximum products"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-2",
      "label": "Colour scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Orlant: cart upsell"
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
