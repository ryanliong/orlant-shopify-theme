{%- comment -%}
  Capabilities — headline figures over an icon grid (round 2 change G).
  Summary of the range; the function blocks below give the detail.
  Figures and cards are blocks, so the client can edit, reorder or remove
  them in the theme editor.
{%- endcomment -%}

{{ 'orlant-capabilities.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
  assign figures = section.blocks | where: 'type', 'figure'
  assign cards = section.blocks | where: 'type', 'card'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="orlant-cap page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <header class="orlant-cap__header{{ reveal }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="orlant-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="orlant-cap__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="orlant-cap__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if figures.size > 0 -%}
      <dl class="orlant-cap__figures{{ reveal }}">
        {%- for block in figures -%}
          <div class="orlant-cap__figure" {{ block.shopify_attributes }}>
            <dt class="orlant-cap__figure-label">{{ block.settings.label }}</dt>
            <dd class="orlant-cap__figure-value">{{ block.settings.value }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <ul class="orlant-cap__grid list-unstyled" role="list">
        {%- for block in cards -%}
          <li class="orlant-cap__card{{ reveal }}" {{ block.shopify_attributes }}>
            <span class="orlant-cap__icon">{%- render 'orlant-icon', icon: block.settings.icon -%}</span>
            <h3 class="orlant-cap__card-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="orlant-cap__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% render 'orlant-section-padding', section: section %}

{% schema %}
{
  "name": "Orlant: capabilities",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Capabilities" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to dry more" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Colour scheme" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Headline figure",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "55 kg" },
        { "type": "text", "id": "label", "label": "Label", "default": "Maximum load" }
      ]
    },
    {
      "type": "card",
      "name": "Capability card",
      "limit": 12,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "wind", "options": [{"value": "wind", "label": "Airflow"}, {"value": "flame", "label": "Heat"}, {"value": "sparkle", "label": "UV / ioniser"}, {"value": "rails", "label": "Poles"}, {"value": "lift", "label": "Lifting"}, {"value": "weight", "label": "Load"}, {"value": "shield", "label": "Protection"}, {"value": "phone", "label": "App"}, {"value": "mic", "label": "Voice"}, {"value": "bulb", "label": "Light"}, {"value": "thin", "label": "Ultra-thin"}, {"value": "cable", "label": "Cables"}, {"value": "quiet", "label": "Quiet"}, {"value": "display", "label": "Display"}, {"value": "tool", "label": "Installation"}, {"value": "truck", "label": "Delivery"}, {"value": "star", "label": "Quality"}, {"value": "chat", "label": "Support"}] },
        { "type": "text", "id": "title", "label": "Title", "default": "Hot and cold airflow" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Orlant: capabilities",
      "blocks": [
        { "type": "figure" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
