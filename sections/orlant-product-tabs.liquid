{{ 'orlant-product-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'orlant-tabs.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Product information tabs.

  Every panel is fed by a metafield so all products share one structure, and
  any panel whose metafield is empty is dropped entirely — a half-filled
  product shows fewer tabs rather than empty ones.

  One set of buttons serves both layouts. On mobile the container is a plain
  block, so source order gives header/panel/header/panel — an accordion. On
  desktop it becomes a flex row where buttons take order 0 and panels order 1,
  hoisting every button into a tab strip above a single panel. Duplicating the
  buttons for each layout would be simpler to write but would put two copies of
  every label in the accessibility tree.
{%- endcomment -%}

{%- liquid
  assign overview = product.metafields.orlant.overview
  assign specs = product.metafields.orlant.specs.value
  assign in_the_box = product.metafields.orlant.in_the_box
  assign installation = product.metafields.orlant.installation
  assign warranty = product.metafields.orlant.warranty
  assign faq = product.metafields.orlant.faq.value

  assign has_specs = false
  if specs != blank and specs.size > 0
    assign has_specs = true
  endif

  assign has_faq = false
  if faq != blank and faq.size > 0
    assign has_faq = true
  endif

  assign panel_count = 0
  if overview != blank
    assign panel_count = panel_count | plus: 1
  endif
  if has_specs
    assign panel_count = panel_count | plus: 1
  endif
  if in_the_box != blank
    assign panel_count = panel_count | plus: 1
  endif
  if installation != blank
    assign panel_count = panel_count | plus: 1
  endif
  if warranty != blank
    assign panel_count = panel_count | plus: 1
  endif
  if has_faq
    assign panel_count = panel_count | plus: 1
  endif
-%}

{%- if panel_count > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div
      class="orlant-tabs-wrapper page-width section-{{ section.id }}-padding"
      style="--orlant-tabs-count: {{ panel_count }};"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="orlant-tabs__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <orlant-tabs class="orlant-tabs" data-section-id="{{ section.id }}">
        {%- assign index = 0 -%}

        {%- if overview != blank -%}
          {%- capture panel_id %}{{ section.id }}-overview{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_overview | default: 'Overview' }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel rte"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            {{ overview | metafield_tag }}
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}

        {%- if has_specs -%}
          {%- capture panel_id %}{{ section.id }}-specs{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_specs | default: 'Specifications' }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            <table class="orlant-specs">
              <tbody>
                {%- for row in specs -%}
                  <tr class="orlant-specs__row">
                    <th class="orlant-specs__label" scope="row">{{ row.label.value }}</th>
                    <td class="orlant-specs__value">{{ row.value.value }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}

        {%- if in_the_box != blank -%}
          {%- capture panel_id %}{{ section.id }}-in-the-box{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_in_the_box | default: "What's in the box" }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel rte"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            {{ in_the_box | metafield_tag }}
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}

        {%- if installation != blank -%}
          {%- capture panel_id %}{{ section.id }}-installation{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_installation | default: 'Installation & compatibility' }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel rte"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            {{ installation | metafield_tag }}
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}

        {%- if warranty != blank -%}
          {%- capture panel_id %}{{ section.id }}-warranty{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_warranty | default: 'Warranty' }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel rte"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            {{ warranty | metafield_tag }}
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}

        {%- if has_faq -%}
          {%- capture panel_id %}{{ section.id }}-faq{% endcapture -%}
          <button
            class="orlant-tabs__trigger"
            type="button"
            id="trigger-{{ panel_id }}"
            data-index="{{ index }}"
            aria-controls="panel-{{ panel_id }}"
          >
            <span>{{ section.settings.label_faq | default: 'FAQ' }}</span>
            {%- render 'orlant-tabs-chevron' -%}
          </button>
          <div
            class="orlant-tabs__panel"
            id="panel-{{ panel_id }}"
            data-index="{{ index }}"
            aria-labelledby="trigger-{{ panel_id }}"
          >
            <dl class="orlant-faq">
              {%- for item in faq -%}
                <div class="orlant-faq__item">
                  <dt class="orlant-faq__q">{{ item.question.value }}</dt>
                  <dd class="orlant-faq__a">{{ item.answer.value | newline_to_br }}</dd>
                </div>
              {%- endfor -%}
            </dl>
          </div>
        {%- endif -%}
      </orlant-tabs>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Orlant: product tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Each panel is fed by a product metafield in the orlant namespace. Panels whose metafield is empty are hidden automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to show the tabs on their own."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Colour scheme"
    },
    {
      "type": "header",
      "content": "Tab labels"
    },
    { "type": "text", "id": "label_overview", "default": "Overview", "label": "Overview" },
    { "type": "text", "id": "label_specs", "default": "Specifications", "label": "Specifications" },
    { "type": "text", "id": "label_in_the_box", "default": "What's in the box", "label": "What's in the box" },
    { "type": "text", "id": "label_installation", "default": "Installation & compatibility", "label": "Installation" },
    { "type": "text", "id": "label_warranty", "default": "Warranty", "label": "Warranty" },
    { "type": "text", "id": "label_faq", "default": "FAQ", "label": "FAQ" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Orlant: product tabs"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
