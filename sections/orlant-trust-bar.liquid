{%- comment -%}
  Trust bar — three or four icon + text reassurance items (brief 4.1.4).
  Editable blocks; the section hides itself when every block is empty.
{%- endcomment -%}

{{ 'orlant-trust-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="orlant-trust page-width section-{{ section.id }}-padding">
      <ul class="orlant-trust__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="orlant-trust__item" {{ block.shopify_attributes }}>
              <span class="orlant-trust__icon">
                {%- render 'orlant-icon', icon: block.settings.icon -%}
              </span>
              <span class="orlant-trust__text">
                <strong class="orlant-trust__title">{{ block.settings.text }}</strong>
                {%- if block.settings.subtext != blank -%}
                  <span class="orlant-trust__sub">{{ block.settings.subtext }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Orlant: trust bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Colour scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 32 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "tool", "label": "Tool" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat", "label": "Chat" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" }
          ],
          "default": "truck",
          "label": "Icon"
        },
        { "type": "text", "id": "text", "label": "Title", "default": "Local stock, fast delivery" },
        { "type": "text", "id": "subtext", "label": "Supporting line" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Orlant: trust bar",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
