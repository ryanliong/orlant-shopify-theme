{%- comment -%}
  Testimonials — quote, name, home type and star rating (brief 4.1.9).

  Static blocks; a reviews app replaces this later (brief 9.5). Ratings are
  rendered as an accessible number alongside the stars, not stars alone.
{%- endcomment -%}

{{ 'orlant-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="orlant-quotes page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <div class="orlant-quotes__header">
          <hr class="orlant-rule">
          <h2 class="orlant-quotes__heading">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      <ul class="orlant-quotes__grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.quote != blank -%}
            <li class="orlant-quotes__item" {{ block.shopify_attributes }}>
              <figure class="orlant-quotes__figure">
                {%- assign rating = block.settings.rating | plus: 0 -%}
                {%- if rating > 0 -%}
                  <div class="orlant-quotes__rating">
                    <span aria-hidden="true">
                      {%- for i in (1..5) -%}
                        {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
                      {%- endfor -%}
                    </span>
                    <span class="visually-hidden">{{ rating }} out of 5 stars</span>
                  </div>
                {%- endif -%}

                <blockquote class="orlant-quotes__quote">{{ block.settings.quote }}</blockquote>

                <figcaption class="orlant-quotes__caption">
                  {%- if block.settings.name != blank -%}
                    <span class="orlant-quotes__name">{{ block.settings.name }}</span>
                  {%- endif -%}
                  {%- if block.settings.home_type != blank -%}
                    <span class="orlant-quotes__home">{{ block.settings.home_type }}</span>
                  {%- endif -%}
                </figcaption>
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Orlant: testimonials",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Static quotes for now. A reviews app can replace this section later." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Singapore homes say" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Colour scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 52 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Installed in under an hour and the yard finally feels usable again." },
        { "type": "text", "id": "name", "label": "Name", "default": "Wei Lin" },
        { "type": "text", "id": "home_type", "label": "Home type", "default": "4-room HDB, Punggol" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "default": 5, "label": "Star rating", "info": "0 hides the stars." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Orlant: testimonials",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
