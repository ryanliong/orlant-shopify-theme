{%- comment -%}
  Feature split — media on one side, text and bullets on the other.

  Reusable: used on the home page for "Why smart drying" and again on the
  product page for the feature story rows. The image/video side flips per
  instance, so alternating rows are built by stacking the section twice with
  the toggle reversed rather than by hard-coding an odd/even rule.
{%- endcomment -%}

{{ 'orlant-feature-split.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="orlant-split page-width section-{{ section.id }}-padding">
    <div class="orlant-split__grid orlant-split__grid--media-{{ section.settings.media_position }}">
      <div class="orlant-split__media orlant-media">
        {%- if section.settings.video != blank -%}
          <video
            class="orlant-split__video"
            autoplay
            muted
            loop
            playsinline
            {% if section.settings.image != blank %}
              poster="{{ section.settings.image | image_url: width: 1200 }}"
            {% endif %}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src="{{ section.settings.video }}" type="video/mp4">
          </video>
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '400, 600, 800, 1000, 1400',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          {%- comment -%}
            A brand-tinted panel rather than Dawn's apparel placeholder, which
            is the wrong product category here and reads as unfinished. Keeps
            the row presentable before the client's photography arrives.
          {%- endcomment -%}
          <div class="orlant-split__placeholder" role="img" aria-label="Product photography coming soon"></div>
        {%- endif -%}
      </div>

      <div class="orlant-split__text">
        {%- if section.settings.eyebrow != blank -%}
          <hr class="orlant-rule">
          <p class="orlant-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="orlant-split__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="orlant-split__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="orlant-split__list list-unstyled" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li class="orlant-split__item" {{ block.shopify_attributes }}>
                  <span class="orlant-split__icon">
                    {%- render 'orlant-icon', icon: block.settings.icon -%}
                  </span>
                  <span>
                    {%- if block.settings.heading != blank -%}
                      <strong class="orlant-split__item-heading">{{ block.settings.heading }}</strong>
                    {%- endif -%}
                    {{ block.settings.text }}
                  </span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary orlant-split__button">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Orlant: feature split",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Also the video poster." },
    { "type": "url", "id": "video", "label": "Video URL", "info": "Direct MP4 link. Plays muted and looped. Overrides the image." },
    {
      "type": "select",
      "id": "media_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Media position",
      "info": "Flip this on alternating rows."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why smart drying" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Colour scheme" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 52 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Truck" },
            { "value": "tool", "label": "Tool" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "chat", "label": "Chat" }
          ],
          "default": "check",
          "label": "Icon"
        },
        { "type": "text", "id": "heading", "label": "Lead-in", "info": "Optional bold opening, e.g. \"Dries in humid weather\"." },
        { "type": "text", "id": "text", "label": "Text", "default": "Describe the benefit in one sentence." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Orlant: feature split",
      "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }]
    }
  ]
}
{% endschema %}
