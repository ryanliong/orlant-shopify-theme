{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- liquid
      assign models_item = section.settings.orlant_models_menu_item | handleize
      assign series_handles = section.settings.orlant_models_series | remove: ' ' | split: ','
    -%}
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if section.settings.orlant_models_menu and link.handle == models_item -%}
          {%- comment -%}
            Orlant: the Products item lists every model, grouped by series,
            built from the series collections so it stays current as models
            are added, drafted or renamed (round 2, agency request; GoodLiving's
            "Racks" menu as reference). Opens on hover via orlant-header-hover.js.
          {%- endcomment -%}
          <header-menu class="orlant-models-menu">
            <details id="Details-HeaderMenu-{{ forloop.index }}" data-orlant-href="{{ link.url }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.current or link.child_active or template.name == 'collection' or template.name == 'product' %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu orlant-models-menu__panel color-{{ section.settings.menu_color_scheme }} gradient global-settings-popup"
                tabindex="-1"
              >
                <ul class="orlant-models-menu__groups list-unstyled" role="list">
                  {%- for handle in series_handles -%}
                    {%- assign series = collections[handle] -%}
                    {%- if series != blank and series.products_count > 0 -%}
                      <li class="orlant-models-menu__group">
                        <a href="{{ series.url }}" class="orlant-models-menu__series focus-inset">{{ series.title | escape }}</a>
                        <ul class="orlant-models-menu__models list-unstyled" role="list">
                          {%- for model in series.products limit: 12 -%}
                            {%- liquid
                              assign model_name = model.title
                              if section.settings.orlant_models_strip != blank
                                assign model_name = model_name | remove: section.settings.orlant_models_strip | strip
                              endif
                            -%}
                            <li>
                              <a
                                href="{{ model.url }}"
                                class="orlant-models-menu__model focus-inset{% if product and product.id == model.id %} orlant-models-menu__model--current{% endif %}"
                                {% if product and product.id == model.id %}aria-current="page"{% endif %}
                              >
                                <span class="orlant-models-menu__name">{{ model_name | escape }}</span>
                                {%- if section.settings.orlant_models_show_price -%}
                                  <span class="orlant-models-menu__price">{{ model.price | money }}</span>
                                {%- endif -%}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if section.settings.orlant_models_all_label != blank -%}
                  <a href="{{ link.url }}" class="orlant-models-menu__all focus-inset">
                    {{ section.settings.orlant_models_all_label | escape }}
                    <span aria-hidden="true">→</span>
                  </a>
                {%- endif -%}
              </div>
            </details>
          </header-menu>
        {%- elsif link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" data-orlant-href="{{ link.url }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
