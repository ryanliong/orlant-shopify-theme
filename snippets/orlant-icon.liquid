{% comment %}
  Line icons used by the reassurance row, trust bar, capabilities grid and
  function blocks.

  Simple 24x24 stroke icons drawn inline rather than loaded as a sprite —
  inlining avoids a request and a flash of no icon.

  Accepts:
  - icon: {String} One of truck, tool, shield, lock, star, heart, chat, check,
    wind, flame, sparkle, lift, weight, phone, mic, bulb, thin, cable, quiet,
    rails, display.

  Usage:
  {% render 'orlant-icon', icon: 'truck' %}
{% endcomment %}

<svg
  class="orlant-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'tool' -%}
      <path d="M14.5 5.5a3.5 3.5 0 0 0 4.6 4.6l-8.4 8.4a2 2 0 0 1-2.8-2.8z"/><path d="m5 5 3 3"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5c0 4.2 2.9 8 7 9 4.1-1 7-4.8 7-9V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'star' -%}
      <path d="m12 4 2.4 5 5.6.8-4 3.9 1 5.5-5-2.6-5 2.6 1-5.5-4-3.9 5.6-.8z"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-9a3.9 3.9 0 0 1 7-2.4A3.9 3.9 0 0 1 19 11c0 4.6-7 9-7 9z"/>
    {%- when 'chat' -%}
      <path d="M20 12a7 7 0 0 1-9.9 6.4L4 20l1.6-5.1A7 7 0 1 1 20 12z"/>
    {%- when 'wind' -%}
      <path d="M3 8h11a3 3 0 1 0-3-3"/><path d="M3 12h16a3 3 0 1 1-3 3"/><path d="M3 16h7"/>
    {%- when 'flame' -%}
      <path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-4 2.5-5 0 2 1 3 2 3 0-3-1-5.5.5-8z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/><circle cx="12" cy="12" r="2.2"/>
    {%- when 'lift' -%}
      <path d="M4 3h16"/><path d="M12 6v15"/><path d="m8.5 9.5 3.5-3.5 3.5 3.5"/><path d="m8.5 17.5 3.5 3.5 3.5-3.5"/>
    {%- when 'weight' -%}
      <path d="M6.5 8h11l2.5 12H4z"/><circle cx="12" cy="5.5" r="2.5"/>
    {%- when 'phone' -%}
      <rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>
    {%- when 'mic' -%}
      <rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M9 21h6"/>
    {%- when 'bulb' -%}
      <path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>
    {%- when 'thin' -%}
      <path d="M3 4h18"/><rect x="4" y="7" width="16" height="3.5" rx="1"/><path d="M12 14v6M9.5 17.5 12 20l2.5-2.5"/>
    {%- when 'cable' -%}
      <path d="M8 3v18M16 3v18"/><path d="m8 6 8 3M8 11l8 3M8 16l8 3"/>
    {%- when 'quiet' -%}
      <path d="M4 9.5h3l4.5-4v13L7 14.5H4z"/><path d="M15.5 9.5a3.5 3.5 0 0 1 0 5"/>
    {%- when 'rails' -%}
      <path d="M3 4h18"/><path d="M7 4v4M17 4v4"/><path d="M3 9h18M3 13h18M3 17h18"/>
    {%- when 'display' -%}
      <rect x="3" y="5" width="18" height="12" rx="1.5"/><path d="M8 21h8M12 17v4"/>
    {%- else -%}
      <path d="m5 12.5 4.2 4.2L19 7"/>
  {%- endcase -%}
</svg>
